# Copie para .env e troque todos os valores.
# Gere segredos com: openssl rand -hex 32
POSTGRES_PASSWORD=troque-esta-senha
JWT_SECRET=troque-por-um-segredo-com-pelo-menos-32-caracteres
GATEWAY_TOKEN=troque-por-um-token-com-16-ou-mais
# Porta do painel no servidor (http://<ip>:8080)
PORTA_PAINEL=8080
# Rede ou IP do proxy HTTPS na frente do painel, para o limite de login ver o IP real do cliente.
# Sem proxy: deixe 127.0.0.1/32. Caddy em Docker no mesmo host: 172.16.0.0/12.
PROXY_CONFIAVEL=127.0.0.1/32
# Deixe vazio: o painel e a API ficam no mesmo endereço (sem CORS)
CORS_ORIGENS=
