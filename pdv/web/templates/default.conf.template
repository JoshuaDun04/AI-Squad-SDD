server {
  listen 8080;
  server_name _;
  root /usr/share/nginx/html;
  server_tokens off;

  # IP real do cliente quando há um proxy HTTPS (Caddy, Nginx) na frente deste painel (REV-18).
  # PROXY_CONFIAVEL = rede ou IP desse proxy. Sem proxy na frente, o padrão não confia em ninguém.
  set_real_ip_from ${PROXY_CONFIAVEL};
  real_ip_header X-Forwarded-For;
  real_ip_recursive on;

  add_header X-Content-Type-Options nosniff always;
  add_header X-Frame-Options DENY always;
  add_header Referrer-Policy same-origin always;
  # Só código do próprio painel; o QR code chega como data: URL (REV-16)
  add_header Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self'; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;

  # API atrás do mesmo domínio: sem CORS (SEC-02)
  location /api/ {
    proxy_pass http://api:8000/;
    proxy_set_header Host $host;
    # Sobrescreve (não acrescenta): o cliente não consegue forjar o próprio IP (REV-07)
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  # O webhook do gateway é interno; não fica exposto pelo painel
  location /api/canal/ {
    return 404;
  }

  location / {
    try_files $uri /index.html;
  }
}
