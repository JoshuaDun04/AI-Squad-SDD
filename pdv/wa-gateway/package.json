{
  "name": "pdv-wa-gateway",
  "version": "0.1.0",
  "private": true,
  "description": "Transporte WhatsApp (Baileys) do PDV Restaurantes: sessão por restaurante, QR code e repasse de mensagens. Sem regra de negócio (ADR-0002).",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "baileys": "^7.0.0-rc14",
    "express": "^5.2.1",
    "pino": "^9.14.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
